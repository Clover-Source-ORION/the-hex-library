# Puerto del servidor (0 = puerto efimero, util en pruebas)
PORT=3000

# production | development | test
NODE_ENV=development

# Origenes extra permitidos por CORS, separados por coma.
# Dejalo VACIO si abres el sitio desde el propio backend (http://localhost:3000).
# Solo necesario si usas Live Server u otro puerto para el frontend.
# ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Directorio de persistencia (por defecto backend/data)
# DATA_DIR=./data

# Rate limit de envios del formulario
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5

# --- Administracion ---------------------------------------------------------
# Credenciales del panel. Cambialas en produccion.
ADMIN_USER=Admin_Clover
ADMIN_PASSWORD=Hex-Library

# Secreto de firma de la sesion. OBLIGATORIO en produccion: sin el se genera
# uno aleatorio en cada arranque y todas las sesiones se invalidan al reiniciar.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Duracion de la sesion en milisegundos (por defecto 8 horas)
SESSION_TTL_MS=28800000

# Freno de fuerza bruta en el login
LOGIN_WINDOW_MS=900000
LOGIN_MAX_INTENTOS=8
