# Puerto en el que corre el servidor
PORT=3000

# Entorno de ejecucion (development, production, test)
NODE_ENV=development

# Dominio u origen permitido por CORS (opcional)
# ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Directorio donde se almacenan los datos del sistema
# DATA_DIR=./data

# Limite de envios de formulario (tiempo en ms y maximo de intentos)
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5

# Credenciales de acceso para el panel de administracion
ADMIN_USER=Admin_Clover
ADMIN_PASSWORD=Hex-Library

# Clave secreta para firmar y mantener las sesiones
# SESSION_SECRET=

# Tiempo de duracion de la sesion activa (en milisegundos)
SESSION_TTL_MS=28800000

# Proteccion contra fuerza bruta en el login (tiempo en ms e intentos permitidos)
LOGIN_WINDOW_MS=900000
LOGIN_MAX_INTENTOS=8

# Clave de la API de Google Gemini para el asistente
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de IA que usara la API
# GEMINI_MODEL=gemini-2.5-flash

# Tiempo maximo de espera (ms) y limite de tokens por respuesta de la IA
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_TOKENS=2048

# Limite de consultas permitidas al asistente de IA
IA_RATE_LIMIT_WINDOW_MS=300000
IA_RATE_LIMIT_MAX=15